---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Bifrost: the Karolinska Institutet Neuro Research Group’s bridge for exchanging data with partners.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Bifrost</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/"><span class="mark"></span><span><span class="name">Bifrost</span><br /><span class="sub">Karolinska Institutet Neuro Research Group · data bridge</span></span></a>
        <nav class="top"><a href="/">Your bridge</a><a href="/docs/">How to use it</a><a href="/docs/cli/">Command line</a><a href="https://kineuro.se">kineuro.se</a></nav>
      </div>
    </header>
    <main><slot /></main>
    <footer><div class="wrap"><span>Bifrost is run by the Karolinska Institutet Neuro Research Group. Every transfer is checked byte for byte and recorded.</span><span>Questions: <a href="mailto:admin@kineuro.se">admin@kineuro.se</a></span></div></footer>
  </body>
</html>
